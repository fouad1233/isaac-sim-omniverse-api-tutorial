__pycache__/
*.pyc
*.usda.bak
output/
*.log

# generated by running the lectures themselves -- the .md for each lecture
# already shows the expected output inline, so these aren't checked in
lectures/output_*.usda
lectures/output_*.png
# raw numeric dumps a lecture writes for tools/render_figures.py to consume;
# the rendered PNGs under lectures/figures/ are the committed artifact
lectures/data_*.npz
# Module 3 (Isaac Lab) lectures write their findings to a file instead of
# relying on captured stdout -- see lecture20.md/lecture21.md for why. Each
# lecture's .md already shows the expected content inline.
lectures/*_results.txt

# Isaac Sim / Kit scratch state some environments generate in-place
kit_cache/
.nvidia-omniverse/

# generated by tools/setup_vscode.py -- machine-specific (absolute paths to
# your own Isaac Sim install), so it doesn't belong in the repo. Run the
# script yourself; see lecture01.md.
.vscode/settings.json
# also generated by tools/setup_vscode.py (the SimulationApp stub). Its
# content is fixed, not machine-specific, but it's regenerated every run
# right alongside settings.json, so it follows the same run-it-yourself rule.
.vscode/typings/
